# Copy to .env and fill in. Never commit .env.

PORT=3000
# Comma-separated list of origins allowed to call the API (the frontend dev server, etc.)
CORS_ORIGINS=http://localhost:5173

# Supabase project settings -> API Keys (new-style keys, not the legacy anon/service_role)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only secret. Never expose to the frontend.
SUPABASE_SECRET_KEY=sb_secret_...

# Postgres connection string (Supabase project settings -> Database -> Connection string)
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Usernames are mapped to "<username>@<AUTH_EMAIL_DOMAIN>" for Supabase auth.
# .invalid is a reserved TLD, so these addresses can never receive mail.
AUTH_EMAIL_DOMAIN=amherst-pulse.invalid
